# =====================================================================
# QCab API — environment (cPanel "Setup Node.js App")
# Set these either in cPanel > Setup Node.js App > Environment variables
# (recommended) or in a file named .env in the application root.
# =====================================================================

NODE_ENV=production
# PORT is ignored under cPanel/Passenger; only used for local `npm start`.
PORT=3000

# Leave empty if the app lives at the root of its own subdomain
# (recommended: api.yourdomain.com). If you instead mount it at a
# sub-path like yourdomain.com/api, set API_PREFIX=api
API_PREFIX=

# Browser origins allowed to call the API (the admin console).
# Comma-separated. Leave empty to allow any origin.
CORS_ORIGINS=https://admin.yourdomain.com

# --- Database (PostgreSQL 13+; PostGIS NOT required) ------------------
# cPanel PostgreSQL usually prefixes names with your account name:
#   postgres://cpaneluser_qcab:PASSWORD@localhost:5432/cpaneluser_qcab
# URL-encode special characters in the password (@ -> %40, / -> %2F).
DATABASE_URL=postgres://cpaneluser_qcab:CHANGE_ME@localhost:5432/cpaneluser_qcab
# true for remote/managed Postgres (Neon, Supabase, RDS, ...). Leave
# false for a Postgres on the same server (localhost).
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Keep small on shared hosting (connection limits).
DATABASE_POOL_MAX=5

# --- Auth -------------------------------------------------------------
# Generate each with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_64_hex_chars
JWT_REFRESH_SECRET=CHANGE_ME_a_different_64_hex_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- SMS/OTP (Twilio Verify) -----------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# MUST be false on a live server. When true, code 000000 logs in as anyone.
# With NODE_ENV=production the server refuses to start if this is true,
# unless ALLOW_OTP_DEV_BYPASS_IN_PRODUCTION=true is also set.
# With false, ALL THREE Twilio values above are required (SID starts with AC).
OTP_DEV_BYPASS=false

# --- Stripe Connect ---------------------------------------------------
STRIPE_SECRET_KEY=sk_live_or_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CONNECT_REFRESH_URL=https://yourdomain.com/driver/stripe/refresh
STRIPE_CONNECT_RETURN_URL=https://yourdomain.com/driver/stripe/complete
# Leave these three EMPTY on a live server (local stripe-mock testing only).
STRIPE_API_HOST=
STRIPE_API_PORT=
STRIPE_API_PROTOCOL=
